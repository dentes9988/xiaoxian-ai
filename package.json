{
  "name": "98agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install",
    "setup:training:mac": "bash ./scripts/setup-local-training-macos.sh",
    "check:training:mac": "bash ./scripts/check-local-training-macos.sh",
    "setup:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-windows.ps1",
    "check:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/check-windows.ps1",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @98agent/web",
    "test": "vitest run",
    "typecheck": "tsc --build",
    "lint": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "zod": "^4.0.5"
  }
}
